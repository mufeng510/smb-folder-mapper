{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMB Folder Mapper",
  "version": "0.1.0",
  "identifier": "com.smbfoldermapper",

  "build": {
    "frontendDist": "../src"
  },

  "app": {
    "windows": [
      {
        "title": "SMB Folder Mapper",
        "width": 700,
        "height": 520,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 600,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },

  "plugins": {
    "dialog": {}
  },

  "bundle": {
    "active": false
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMB Folder Mapper",
  "version": "0.1.0",
  "identifier": "com.smbfoldermapper.app",

  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },

  "app": {
    "windows": [
      {
        "title": "SMB Folder Mapper",
        "width": 700,
        "height": 520,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 600,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },

  "bundle": {
    "active": true,
    "icon": [
      "icons/ico.ico"
    ]
  }
}
